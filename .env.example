# Copy to .env — never commit .env.
# Optional AI fallback (Gemini API free tier). Leave empty to disable AI entirely.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional tuning
# AI_TIMEOUT_SECONDS=15
# AI_MIN_CONFIDENCE=0.6
# MAX_UPLOAD_MB=10
# MAX_XLSX_UNCOMPRESSED_MB=50
# MAX_ROWS=100000
# MAX_COLUMNS=100
# PENDING_UPLOAD_TTL_HOURS=24
# CLEANUP_INTERVAL_MINUTES=15
# DATABASE_URL=sqlite:///./data/statement_splitter.db
